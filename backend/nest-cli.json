{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      { "include": "src/database/migrations/**/*", "outDir": "dist" }
    ],
    "webpack": false
  },
  "projects": {
    "core": {
      "type": "library",
      "root": "libs/core",
      "entryFile": "index",
      "sourceRoot": "libs/core/src",
      "compilerOptions": {
        "tsConfigPath": "libs/core/tsconfig.lib.json"
      }
    },
    "team-management": {
      "type": "library",
      "root": "libs/team-management",
      "entryFile": "index",
      "sourceRoot": "libs/team-management/src",
      "compilerOptions": {
        "tsConfigPath": "libs/team-management/tsconfig.lib.json"
      }
    },
    "identity": {
      "type": "library",
      "root": "libs/identity",
      "entryFile": "index",
      "sourceRoot": "libs/identity/src",
      "compilerOptions": {
        "tsConfigPath": "libs/identity/tsconfig.lib.json"
      }
    },
    "typeorm": {
      "type": "library",
      "root": "libs/typeorm",
      "entryFile": "index",
      "sourceRoot": "libs/typeorm/src",
      "compilerOptions": {
        "tsConfigPath": "libs/typeorm/tsconfig.lib.json"
      }
    },
    "account-pro": {
      "type": "library",
      "root": "libs/account-pro",
      "entryFile": "index",
      "sourceRoot": "libs/account-pro/src",
      "compilerOptions": {
        "tsConfigPath": "libs/account-pro/tsconfig.lib.json"
      }
    },
    "platform-account": {
      "type": "library",
      "root": "libs/platform-account",
      "entryFile": "index",
      "sourceRoot": "libs/platform-account/src",
      "compilerOptions": {
        "tsConfigPath": "libs/platform-account/tsconfig.lib.json"
      }
    },
    "content": {
      "type": "library",
      "root": "libs/content",
      "entryFile": "index",
      "sourceRoot": "libs/content/src",
      "compilerOptions": {
        "tsConfigPath": "libs/content/tsconfig.lib.json"
      }
    }
  }
}
