{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "testTimeout": 60000,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "@pugying/core(.*)": "<rootDir>/../libs/core/src$1",
    "@pugying/team-management(.*)": "<rootDir>/../libs/team-management/src$1",
    "@pugying/identity(.*)": "<rootDir>/../libs/identity/src$1",
    "@pugying/typeorm(.*)": "<rootDir>/../libs/typeorm/src$1",
    "@pugying/account-pro(.*)": "<rootDir>/../libs/account-pro/src$1",
    "@pugying/platform-account(.*)": "<rootDir>/../libs/platform-account/src$1",
    "@pugying/content(.*)": "<rootDir>/../libs/content/src$1"
  }
}
