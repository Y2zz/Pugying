{
  "include": [
    "electron.vite.config.ts",
    "electron/**/*",
    "shared/**/*"
  ],
  "exclude": ["electron/**/*.test.ts", "shared/**/*.test.ts"],
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    // TS6 起 baseUrl 弃用；paths 别名仍依赖它，与 server 同样静默至 6.0
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  }
}
