{
  "name": "pugying-desktop",
  "version": "0.0.2",
  "private": true,
  "description": "Pugying desktop — electron-vite UI + local Nest server host",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "dist": "npm run build && npm run pack:server && electron-builder --dir",
    "dist:linux": "npm run build && npm run pack:server -- --platform linux --arch x64 && electron-builder --linux --x64 --dir",
    "dist:win": "npm run build && npm run pack:server -- --platform win32 --arch x64 && electron-builder --win --x64 --dir",
    "pack:server": "node scripts/pack-server.mjs",
    "docker:dist:linux": "bash scripts/docker-dist.sh linux",
    "docker:dist:win": "bash scripts/docker-dist.sh win"
  },
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@electron/rebuild": "4.2.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@shadcn/react": "0.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "electron": "44.0.0",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "input-otp": "1.5.0",
    "lucide-react": "1.34.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.3",
    "react-router-dom": "7.18.2",
    "recharts": "3.8.0",
    "shadcn": "4.19.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "tw-animate-css": "1.4.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "local.pugying.desktop",
    "productName": "蒲公英",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "icon",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/server/dist",
        "to": "server/dist"
      },
      {
        "from": "resources/server/package.json",
        "to": "server/package.json"
      },
      {
        "from": "resources/server/node_modules",
        "to": "server/node_modules"
      }
    ],
    "mac": {
      "icon": "icon.icns",
      "category": "public.app-category.productivity",
      "electronLanguages": [
        "zh-CN",
        "en"
      ],
      "target": [
        "dir"
      ]
    },
    "linux": {
      "icon": "icon.png",
      "target": [
        "dir"
      ]
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        "dir"
      ]
    }
  },
  "allowScripts": {
    "electron@44.0.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
