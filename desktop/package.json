{
  "name": "pugying-desktop",
  "version": "0.0.2",
  "private": true,
  "description": "Pugying desktop — electron-vite UI + local Nest server host",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "electron-vite build",
    "start": "node scripts/run-electron-vite.mjs preview",
    "postinstall": "node ./node_modules/electron/install.js",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "package": "npm run build && npm run pack:server && electron-builder",
    "package:dir": "npm run build && npm run pack:server && electron-builder --dir",
    "package:linux": "npm run build && npm run pack:server -- --platform linux --arch x64 && electron-builder --linux --x64 --dir",
    "package:win": "npm run build && npm run pack:server -- --platform win32 --arch x64 && electron-builder --win --x64 --dir",
    "pack:server": "node scripts/pack-server.mjs",
    "docker:package:linux": "bash scripts/docker-package.sh linux",
    "docker:package:win": "bash scripts/docker-package.sh win"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@electron/rebuild": "4.2.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "jsdom": "30.0.1",
    "lucide-react": "1.46.0",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-day-picker": "10.0.1",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.12.4",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  },
  "build": {
    "appId": "local.pugying.desktop",
    "productName": "蒲公英",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/server/dist",
        "to": "server/dist"
      },
      {
        "from": "resources/server/package.json",
        "to": "server/package.json"
      },
      {
        "from": "resources/server/node_modules",
        "to": "server/node_modules"
      }
    ],
    "afterPack": "./scripts/after-pack-mac-adhoc-sign.mjs",
    "mac": {
      "category": "public.app-category.productivity",
      "electronLanguages": [
        "zh-CN",
        "en"
      ],
      "identity": null,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "dir"
      ]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "writeUpdateInfo": false
    },
    "linux": {
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  },
  "allowScripts": {
    "electron@44.3.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "parse5": "8.0.1"
  }
}
