# 个人单机版开发配置模板。发行版由桌面应用注入本机数据路径和安全密钥。

# Server 端口 / 绑定
PORT=3928
SERVER_PORT=3928
HOST=127.0.0.1

# SQLite 路径（可选；桌面默认 userData/server/pugying.db）
# PUGYING_DATABASE_PATH=

# 开发态模拟其它 OS 窗口铬（仅未打包生效）：darwin | win32 | linux
# macOS 上设 win32 只验证顶栏行布局；系统 caption 需在真实 Windows 上查看
# PUGYING_FORCE_PLATFORM=win32

# 平台凭据密钥（本地直接启动 Server / ./start.sh 时必填；桌面发行版由 Electron 注入）
# ./start.sh 缺省使用历史开发默认值，与既有本地 pugying.db 兼容；勿用于发行环境
# PLATFORM_CREDENTIAL_SECRET=pugying-dev-secret-change-me
