# Pugying 部署配置 —— 复制为 .env 后修改（本机 pm2 与 Docker Compose 共用）

# 必填：JWT 签名密钥（生成：openssl rand -hex 32）
JWT_SECRET=

# 浏览器访问后端 API 的地址（构建期注入前端，改为部署机实际地址）
API_BASE_URL=http://192.168.1.5:3000

# 允许跨域的前端来源，逗号分隔（改为部署机实际地址）
CORS_ORIGINS=http://192.168.1.5:8080,http://localhost:5173

# 端口
BACKEND_PORT=3000
FRONTEND_PORT=8080
