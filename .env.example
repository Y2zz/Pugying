# Pugying 部署配置 —— 复制为 .env 后修改（本机 pm2 与 Docker Compose 共用）

# 必填：JWT 签名密钥（生成：openssl rand -hex 32）
JWT_SECRET=

# 浏览器访问后端 API 的地址（构建期注入前端，改为部署机实际地址）
API_BASE_URL=http://192.168.1.5:3000

# Agent 拉取媒体用的对外/局域网基址（禁止默认 localhost；可与 API_BASE_URL 相同）
MEDIA_PUBLIC_BASE_URL=http://192.168.1.5:3000

# 媒体签名密钥（可选，缺省回退 JWT_SECRET）
# MEDIA_SIGNING_SECRET=

# 媒体落盘目录（可选，缺省 backend/data/media）
# MEDIA_STORAGE_DIR=

# 视频大小上限字节（可选，缺省 1073741824 = 1GB）
# MEDIA_MAX_VIDEO_BYTES=1073741824

# 允许跨域的前端来源，逗号分隔（改为部署机实际地址）
CORS_ORIGINS=http://192.168.1.5:8080,http://localhost:5173

# 端口
BACKEND_PORT=3000
FRONTEND_PORT=8080
