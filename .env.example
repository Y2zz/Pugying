# 开发配置模板。复制为仓库根目录 .env.local 后按需填写（勿提交）。
# 以下路径会自动加载 .env / .env.local（已有环境变量优先，不覆盖）：
#   - ./scripts/start.sh、./start.ps1
#   - 直接 cd server && npm run start:dev（及迁移 CLI）
# Desktop 单独 npm run dev 且 PUGYING_EXTERNAL_SERVER=1 时不需要此密钥（由外部 Server 使用）；
# 发行版 / 内嵌 Server 由 Electron 注入本机密钥。

# Server 端口 / 绑定
PORT=3928
SERVER_PORT=3928
HOST=127.0.0.1

# SQLite 路径（可选；桌面默认 userData/server/pugying.db）
# PUGYING_DATABASE_PATH=

# 开发态模拟其它 OS 窗口铬（仅未打包生效）：darwin | win32 | linux
# macOS 上设 win32 只验证顶栏行布局；系统 caption 需在真实 Windows 上查看
# PUGYING_FORCE_PLATFORM=win32

# 平台凭据加密密钥（本地直接启动 Server / ./scripts/start.sh 时必填）
# 必须与加密账号时使用的密钥一致，否则无法打开创作者中心 / 发布，只能重新授权。
# 若库内账号是早期开发缺省加密的，可继续使用：pugying-dev-secret-change-me
# 发行版由 Electron 注入本机密钥；勿把真实密钥提交进仓库
PLATFORM_CREDENTIAL_SECRET=
