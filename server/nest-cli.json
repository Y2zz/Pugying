{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      { "include": "src/database/migrations/**/*", "outDir": "dist" }
    ]
  },
  "projects": {
    "core": {
      "type": "library",
      "root": "libs/core",
      "entryFile": "index",
      "sourceRoot": "libs/core/src",
      "compilerOptions": {
        "tsConfigPath": "libs/core/tsconfig.lib.json"
      }
    },
    "typeorm": {
      "type": "library",
      "root": "libs/typeorm",
      "entryFile": "index",
      "sourceRoot": "libs/typeorm/src",
      "compilerOptions": {
        "tsConfigPath": "libs/typeorm/tsconfig.lib.json"
      }
    },
    "platform-account": {
      "type": "library",
      "root": "libs/platform-account",
      "entryFile": "index",
      "sourceRoot": "libs/platform-account/src",
      "compilerOptions": {
        "tsConfigPath": "libs/platform-account/tsconfig.lib.json"
      }
    },
    "content": {
      "type": "library",
      "root": "libs/content",
      "entryFile": "index",
      "sourceRoot": "libs/content/src",
      "compilerOptions": {
        "tsConfigPath": "libs/content/tsconfig.lib.json"
      }
    }
  }
}
